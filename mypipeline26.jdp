pipeline {
    agent any
    
    environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    
    stages { 
        stage ('PULL STAGE') {
        steps {
            git 'https://github.com/chetanraval07/batch2728-project.git'
            echo 'PULL SUCCESS'
           }
        }
        stage ('BUILD STAGE') {
        steps {
            echo 'BUILD SUCCESS'
            }
        }
        stage ('TEST STAGE') {
        steps {
            echo 'TEST SUCCESS'
            }
        }
        stage ('DEPLOY STAGE') {
        steps {
            echo 'DEPLOY SUCCESS'
            }
        }
    }
}    
