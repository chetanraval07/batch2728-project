pipeline {
    agent any

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {

        stage('PULL STAGE') {
            steps {
                git 'https://github.com/chetanraval07/batch2728-project.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD STAGE') {
            steps {
                dir('backend') {
                    sh 'java -version'
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST STAGE') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    dir('backend') {
                        sh '''
                            mvn sonar:sonar \
                            -Dsonar.projectKey=my-appB2728 \
                            -Dsonar.projectName=my-appB2728
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }


        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'sonar-cred'
                echo 'DEPLOY SUCCESS'
                }
	    }
        }

        stage('CONTINUOUS DELIEVERY') {
            steps {
                sh 'aws s3 cp /backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar s3://for-jenkins-project-backup-buxx/student-app-B2827'
            }
        }

         stage('DEPLOY STAGE') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
 }
